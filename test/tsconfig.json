{
  // The whole client suite as one project: what `oxlint`'s type-aware rules resolve against, and
  // what `bun run typecheck` compiles after the per-case projects. The per-case tsconfigs under
  // cases/ stay the source of truth for the generated hooks — each compiles one library's output
  // with that library's own types.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // oxlint.config.ts reuses the package config by its `.ts` path.
    "allowImportingTsExtensions": true,
    // The generated clients are typed by the host app under this name; the cases map it the same.
    "paths": {
      "@asphodelos/host": ["./hosts/users-app.ts"]
    }
  },
  "include": [
    "*.ts",
    "client",
    "hosts",
    "monorepo",
    "path-params",
    "query-params",
    "runtime",
    "scripts",
    "types"
  ],
  // The client and monorepo cases' generated apps are scaffolds whose handlers are not written,
  // and the monorepo's package names resolve only through its own tsconfig; each says so.
  "exclude": ["client/__generated__", "monorepo/apps"]
}
