{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // `@asphodelos/host` is the app the generated client is typed by: the host app, whose routes
    // are the document's and whose handlers are written.
    "paths": {
      "@asphodelos/host": ["../../hosts/users-app.ts"]
    }
  },
  "include": [
    "asphodelos.config.ts",
    "../../__generated__/tanstack-query/client.ts",
    "../../__generated__/tanstack-query/hooks.ts",
    "../../hosts/env.ts",
    "../../hosts/users-app.ts",
    "../../runtime/tanstack-query.test.ts",
    "../../runtime/tanstack-query-mutation.test.tsx",
    "../../types/tanstack-query.ts",
    "../../types/assert.ts"
  ],
  "exclude": ["app/**"]
}
