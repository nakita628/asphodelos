{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `@asphodelos/host` is the app the generated client is typed by: the host app, whose routes
    // are the document's and whose handlers are written.
    "paths": {
      "@asphodelos/host": ["../../hosts/users-app.ts"]
    }
  },
  "include": [
    "asphodelos.config.ts",
    "../../__generated__/svelte-query/client.ts",
    "../../__generated__/svelte-query/hooks.ts",
    "../../hosts/users-app.ts",
    "../../types/svelte-query.ts",
    "../../types/assert.ts"
  ],
  "exclude": ["app/**"]
}
