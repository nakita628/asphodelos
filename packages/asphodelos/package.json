{
  "name": "asphodelos",
  "version": "0.2.1",
  "description": "Asphodelos is a code generator from OpenAPI to Elysia",
  "keywords": [
    "elysia",
    "openapi"
  ],
  "homepage": "https://github.com/nakita628/asphodelos#readme",
  "bugs": {
    "url": "https://github.com/nakita628/asphodelos/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakita628/asphodelos.git",
    "directory": "packages/asphodelos"
  },
  "bin": {
    "asphodelos": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@asphodelos/source": "./src/config/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite-plugin": {
      "@asphodelos/source": "./src/vite-plugin/index.ts",
      "types": "./dist/vite-plugin/index.d.mts",
      "import": "./dist/vite-plugin/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@typespec/compiler": "^1.16.0",
    "@typespec/openapi3": "^1.16.0",
    "effect": "4.0.0-rc.112",
    "oxfmt": "^0.67.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@sinclair/typebox": "^0.34.49",
    "@types/bun": "latest",
    "@typespec/http": "1.16.0",
    "@typespec/rest": "0.86.0",
    "@typespec/versioning": "0.86.0",
    "elysia": "^1.4.28",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.21.10"
  }
}
